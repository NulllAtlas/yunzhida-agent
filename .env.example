# 复制本文件为 .env 后填写真实值（.env 已被 gitignore，不会进仓库）
# 真实 API Key 由队长在组群发布
#
# 本文件同时服务两种启动方式：
#   1) 本地直跑后端（cd backend && uvicorn app.main:app）—— 由 app/core/config.py 读取；
#   2) docker compose up —— 由 docker-compose.yml 做 ${VAR} 变量替换。
# 不带默认值的项留空即使用代码内置默认值，MVP 演示无需填写任何 Key。

# ========== 模型网关（MoMA，OpenAI 兼容） ==========

# MoMA 平台 API Key（队长申请的团队Token）
MOMA_API_KEY=

# MoMA 统一 API 网关地址（以平台API文档为准）
MOMA_BASE_URL=

# 模型ID（从MoMA模型详情页复制准确ID）
# 高频简单任务用的便宜模型
MODEL_FAST=
# 核心推理/生成用的强模型（判定节点用这个）
MODEL_STRONG=

# 是否使用 mock：true = 全链路确定性 mock，无需任何凭据即可跑通演示；
# 填好上面四项后改为 false 即接入真实模型（失败自动回退规则匹配）
USE_MOCK=true

# LLM 调用超时与重试（秒 / 次）
# 超时后自动回退规则匹配，结果确定且秒级返回；调大只会让用户等更久
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# ========== 运行参数 ==========

# 同时执行的多智能体任务上限（信号量限流）
MAX_CONCURRENCY=4

# 单任务超时熔断（秒）。CPU 上 YOLO 逐帧检测较慢，短视频约 1-3 分钟，默认 600
TASK_TIMEOUT_S=600

# JWT 签名密钥 —— 部署到公网务必改成随机长字符串！
JWT_SECRET=roadmind-dev-secret-change-me
# Token 有效期（分钟），默认 7 天：配合界面端的"同设备记住登录"，一周内免重复登录
JWT_EXPIRE_MIN=10080

# 运行时切换模型：允许在首页直接填 url / key / model 切换大模型（先测后换）。
# ⚠️ 这组接口能改写后端正在使用的模型凭据，只应在本机演示时开放。
# 部署到公网务必设为 false，否则任何人都能改你的模型配置与 Key。
ALLOW_RUNTIME_LLM_CONFIG=true

# ========== 存储 ==========

# SQLite 案件/用户库（本地直跑用相对路径；docker compose 会覆盖为 /app/data/roadmind.db）
DB_PATH=./data/roadmind.db

# chromadb 向量库目录（本地直跑用相对路径；docker compose 会覆盖为 /app/data/chroma）
CHROMA_DIR=./data/chroma

# 上传与产出目录
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
# 单次上传大小上限（MB）
MAX_UPLOAD_MB=100

# ========== 视频感知（M1 · YOLO 检测+追踪） ==========

# ultralytics 模型权重名（CPU 上 yolov8s / yolov8n 较合适）
ALGO_MODEL_NAME=yolov8s.pt
# 检测置信度阈值
ALGO_CONF=0.3
# 抽帧步长：每 N 帧检测一帧（CPU 提速，2 = 约两倍速）
ALGO_VID_STRIDE=2
# 文字降级场景（无视频/检测失败）的默认感知置信度
PERCEPTION_CONFIDENCE=0.55

# 确定性事故门控（仅视频来源）：由代码而非 LLM 判定"是否真实事故"
# 最高目标速度低于此值(km/h) → 判为非事故
GATE_MIN_SPEED_KMH=10.0
# 最高碰撞事件置信度低于此值 → 判为非事故
GATE_MIN_EVENT_CONF=0.6
