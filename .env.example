# 复制本文件为 .env 后填写真实值（.env 已被 gitignore，不会进仓库）
# 真实 API Key 由队长在组群发布

# MoMA 平台 API Key（队长申请的团队Token）
MOMA_API_KEY=

# MoMA 统一 API 网关地址（以平台API文档为准）
MOMA_BASE_URL=

# 模型ID（从MoMA模型详情页复制准确ID）
# 高频简单任务用的便宜模型
MODEL_FAST=
# 核心推理/生成用的强模型
MODEL_STRONG=

# 感知服务（可选，D6）：P3 提供的 POST /perceive 地址（如 http://localhost:9000）
# 留空或调用失败时，感知阶段自动回落本地文字降级场景，不影响主流程
PERCEPTION_SERVICE_URL=
